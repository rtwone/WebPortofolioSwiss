# ============================================================================
# SUPABASE & RESEND API CONFIGURATION
# Salin file ini menjadi `.env` di root proyek, lalu isi dengan kredensial Anda.
# ============================================================================

# 1. Supabase Database & Auth
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Resend Email API (https://resend.com/api-keys)
VITE_RESEND_API_KEY=re_your_api_key_here
VITE_RESEND_FROM_EMAIL=Portfolio Inquiry <onboarding@resend.dev>
VITE_RESEND_TO_EMAIL=irfanhariyanto@gmail.com

# 3. Kunci akses rahasia untuk login cepat di /admin
VITE_ADMIN_ACCESS_KEY=irfan-admin-2025
